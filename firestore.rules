rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous'); }

    function isProjectValid(data) {
      return data.keys().hasAll(['ownerId', 'title', 'files', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() <= 100
        && data.files is map
        && data.createdAt is number
        && data.updatedAt is number
        && (data.get('activeFile', '') is string && data.get('activeFile', '').size() <= 100)
    }

    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(projectId)
        && isProjectValid(incoming());

      allow update: if isSignedIn() && isValidId(projectId)
        && existing().ownerId == request.auth.uid
        && isProjectValid(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'files', 'activeFile', 'updatedAt']);
        
      allow delete: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
    }
  }
}
